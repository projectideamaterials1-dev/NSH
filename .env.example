# Copy to .env and fill in before `docker compose -f docker-compose.prod.yml up`.
# .env is gitignored - never commit real secrets.

# Required: Redis auth. Generate with e.g. `openssl rand -hex 32`.
REDIS_PASSWORD=

# Optional: API-key auth for /api/*. Leave both empty to disable auth entirely.
# Comma-separated for multiple operators/keys (rotate by adding a new one before removing the old).
API_KEYS_OPERATOR=
API_KEYS_READONLY=

# Optional: per-client request cap on /api/* (0 = off).
RATE_LIMIT_PER_MINUTE=0

# Optional: trust X-Forwarded-For/X-Real-IP only from these peer IPs (set to the nginx
# service's address if running behind it).
TRUSTED_PROXY_IPS=

# Optional: allow-list for browser clients on a different origin than this backend.
ALLOWED_ORIGINS=

# Optional: refuse to start rather than run in-memory-only if Redis is unreachable.
REQUIRE_DURABLE_STATE=0

# Optional: real-world data loaded on startup (see GET /api/catalog/sources).
# Fleet sources (all of them shown; satellites are shared fairly up to REALWORLD_MAX_SATELLITES)
REALWORLD_FLEET=isro-eo,stations,planet,oneweb,starlink,gps-ops,weather,resource,science
REALWORLD_OBJECTS=fengyun-1c-debris,cosmos-2251-debris,iridium-33-debris
REALWORLD_LIVE=1
# How many satellites (1-500) and debris objects (0-20000) to load on first start.
REALWORLD_MAX_SATELLITES=60
REALWORLD_MAX_OBJECTS=5000

AUTOPILOT=1

# Optional: bearer token required by GET /metrics (also set in monitoring/prometheus.yml).
METRICS_TOKEN=

# Resource ceilings (docker-compose.prod.yml).
BACKEND_CPUS=2.0
BACKEND_MEMORY=2g
REDIS_MAXMEMORY=384mb

# Monitoring profile (`--profile monitoring`): set a Grafana admin password (default admin/admin, changed at first login).
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_RETENTION=15d

# Data-feed health thresholds (seconds / days).
FEED_CELESTRAK_STALE_S=21600
FEED_ELEMENT_STALE_DAYS=3
FEED_NOAA_STALE_S=7200

# Set by scripts/deploy.sh: the released backend image to run instead of building locally.
BACKEND_IMAGE=
