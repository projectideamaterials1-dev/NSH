# Copy to .env and fill in before `docker compose -f docker-compose.prod.yml up`.
# .env is gitignored - never commit real secrets.

# Required: Redis auth. Generate with e.g. `openssl rand -hex 32`.
REDIS_PASSWORD=

# Recommended: named users with hashed, expiring keys - the audit trail then names the person.
#   docker compose -f docker-compose.prod.yml exec backend python3 scripts/apikeys.py add-user alice --role operator
#   docker compose -f docker-compose.prod.yml exec backend python3 scripts/apikeys.py issue alice
# Stored in backend/data/api_users.json (override with API_USERS_FILE); rotation needs no restart.
API_USERS_FILE=
# Optional shared keys (legacy) for /api/*. Leave both empty (and add no users) to disable auth.
# Comma-separated for multiple operators/keys (rotate by adding a new one before removing the old).
API_KEYS_OPERATOR=
API_KEYS_READONLY=

# Optional: per-client request cap on /api/* (0 = off).
RATE_LIMIT_PER_MINUTE=0

# Optional: trust X-Forwarded-For/X-Real-IP only from these peer IPs (set to the nginx
# service's address if running behind it).
TRUSTED_PROXY_IPS=

# Optional: allow-list for browser clients on a different origin than this backend.
ALLOWED_ORIGINS=

# Optional: refuse to start rather than run in-memory-only if Redis is unreachable.
REQUIRE_DURABLE_STATE=0

# Optional: real-world data loaded on startup (see GET /api/catalog/sources).
# Fleet sources (all of them shown; satellites are shared fairly up to REALWORLD_MAX_SATELLITES)
REALWORLD_FLEET=isro-eo,stations,planet,oneweb,starlink,gps-ops,weather,resource,science
REALWORLD_OBJECTS=fengyun-1c-debris,cosmos-2251-debris,iridium-33-debris
REALWORLD_LIVE=1
# How many satellites (1-500) and debris objects (0-20000) to load on first start.
REALWORLD_MAX_SATELLITES=60
REALWORLD_MAX_OBJECTS=5000

AUTOPILOT=1

# Optional: bearer token required by GET /metrics (also set in monitoring/prometheus.yml).
METRICS_TOKEN=

# Resource ceilings (docker-compose.prod.yml).
BACKEND_CPUS=2.0
BACKEND_MEMORY=2g
REDIS_MAXMEMORY=384mb

# Monitoring profile (`--profile monitoring`): set the Grafana admin login (default admin/admin, changed at first login).
# Applied only when Grafana first initialises its data volume.
PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=


# Data-feed health thresholds (seconds / days).
FEED_CELESTRAK_STALE_S=21600
FEED_ELEMENT_STALE_DAYS=3
FEED_NOAA_STALE_S=7200

# Set by scripts/deploy.sh: the released backend image to run instead of building locally.
BACKEND_IMAGE=

# Optional: Space-Track.org account for public CDMs (authoritative Pc/miss cross-check), polled hourly.
SPACETRACK_IDENTITY=
SPACETRACK_PASSWORD=

# Scheduled backups (`backup` profile): interval and how many to keep locally. Off-site target in backup.env.
BACKUP_INTERVAL=6h
BACKUP_KEEP=28

# Physics engine: auto (CUDA for large calls when an NVIDIA GPU + backend/requirements-gpu.txt are
# available, C++ otherwise), cuda (always GPU), cpp (never GPU). Docker: add docker-compose.gpu.yml.
ACM_ENGINE=auto
ACM_GPU_MIN_OBJECTS=1000
ACM_GPU_MIN_WORK=5e6
# Multi-GPU hosts: split the screening engine and the LLM across cards (UUIDs from
# `nvidia-smi --query-gpu=index,name,uuid --format=csv`, or indexes). Unset = engine on GPU 0, LLM anywhere.
PHYSICS_GPU=
LLM_GPU=

# Operator assistant (local LLM): Ollama on the host, e.g. `ollama pull qwen3:8b`. The model shares the
# GPU with the physics engine - ASSISTANT_KEEP_ALIVE unloads it that long after the last question
# (qwen3:4b if 8 GB of VRAM is tight).
ASSISTANT_OLLAMA_URL=http://host.docker.internal:11434
ASSISTANT_MODEL=qwen3:8b
ASSISTANT_KEEP_ALIVE=2m
ASSISTANT_NUM_CTX=8192
