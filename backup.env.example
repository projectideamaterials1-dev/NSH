# Off-site backup target for the `backup-offsite` service (copy to backup.env, which is gitignored).
# Any rclone backend works; configure it with RCLONE_CONFIG_<NAME>_* variables, then point
# RCLONE_REMOTE at <name>:<bucket>/<path>. Example: S3 (or any S3-compatible store).
RCLONE_REMOTE=offsite:my-acm-backups/production
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=AWS
RCLONE_CONFIG_OFFSITE_REGION=eu-central-1
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# Seconds between off-site copies.
BACKUP_SYNC_S=900
